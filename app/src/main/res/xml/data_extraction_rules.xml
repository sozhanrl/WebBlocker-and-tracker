<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude Room databases (contain personal blocking data) from cloud backup -->
        <exclude domain="database" path="openfocus.db" />
        <exclude domain="database" path="openfocus.db-shm" />
        <exclude domain="database" path="openfocus.db-wal" />
        <!-- Include user preferences -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
