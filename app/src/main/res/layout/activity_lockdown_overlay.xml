<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B1A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Big Lock Icon -->
    <TextView
        android:id="@+id/tvLockIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="64sp" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvLockdownTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Focus Study Lockdown"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center" />

    <!-- Reason Subtitle -->
    <TextView
        android:id="@+id/tvLockdownReason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="5 attempts detected on blocked target during active study session."
        android:textColor="#EF4444"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAlignment="center" />

    <!-- Live Countdown Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="#151D3B"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvCountdownHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE LOCKED — BACK IN"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvCountdownTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="05:00"
            android:textColor="#38BDF8"
            android:textSize="44sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLockdownExplanation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Screen is locked to protect your NEET study focus. Normal access will be restored once the countdown reaches zero."
        android:textColor="#64748B"
        android:textSize="11sp"
        android:textAlignment="center"
        android:lineSpacingExtra="2dp" />

    <!-- Return to NEET Tracker Button -->
    <Button
        android:id="@+id/btnOpenNeetTracker"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#1C2541"
        android:text="Open NEET Tracker"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
