<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1520"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <!-- Cute Mascot with Computer & Unplugged Cable -->
        <ImageView
            android:id="@+id/ivWebsiteMascot"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:adjustViewBounds="true"
            android:contentDescription="Blocker Mascot"
            android:scaleType="fitCenter"
            android:src="@drawable/img_blocker_mascot" />

        <!-- Motivational Headline -->
        <TextView
            android:id="@+id/tvWebsiteHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="You’re one good choice closer to your best self."
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Block Notice Description -->
        <TextView
            android:id="@+id/tvWebsiteBlockNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="‘asurascans.com’ was blocked by OpenFocus as it was added to your block list."
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <!-- Blocked Reason Label -->
        <TextView
            android:id="@+id/tvWebsiteReasonHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Blocked Reason:"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Blocked Reason Content -->
        <TextView
            android:id="@+id/tvWebsiteReasonContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="asurascans.com"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Counter for Today's Blocked Sessions -->
        <TextView
            android:id="@+id/tvWebsiteCounterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Number of sessions blocked today : 1"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Warning / Strike Status Badge -->
        <TextView
            android:id="@+id/tvWebsiteWarningBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Focus Protection Warning 1 of 5"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <!-- Countdown / Return Pill Button -->
        <Button
            android:id="@+id/btnWebsitePillCountdown"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_pill_button"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="1"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
