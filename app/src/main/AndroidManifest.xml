<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== PERMISSIONS ===== -->
    <!-- Usage stats: Required for app usage insights screen -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Foreground service: Required for focus timer to run in background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Post notifications: Required for focus timer and blocking notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot receiver: Restores active routines and blocking after device restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Vibration: For notification and timer alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Internet: Required only if user chooses VPN-based blocking -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bind VPN: Required for local DNS-based website blocking (optional feature) -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />

    <!-- Alarm: Required for exact routine scheduling -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Query packages: Required to list installed apps for blocking -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Biometric: For app lock feature -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Wake lock: For WorkManager workers -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".OpenFocusApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenFocus"
        tools:targetApi="31">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OpenFocus.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Block Screen Activity: Shown when a blocked app/site is detected -->
        <activity
            android:name=".ui.screens.blockscreen.BlockScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.OpenFocus" />

        <!-- Website Blocked Activity: Shown on browser domain block/warning -->
        <activity
            android:name=".ui.screens.blockscreen.WebsiteBlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.OpenFocus" />

        <!-- Lockdown Overlay Activity: Shown when 5 strikes reached (Stage 1 / Stage 2) -->
        <activity
            android:name=".ui.screens.blockscreen.LockdownOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.OpenFocus" />

        <!-- Accessibility Service: Detects foreground app changes for app blocking -->
        <!-- DISCLOSURE: This service monitors which app is in the foreground ONLY to
             enforce user-configured app blocking rules. It does NOT read content,
             keystrokes, passwords, messages, or any private data. -->
        <service
            android:name=".service.accessibility.OpenFocusAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- VPN Service: Optional local DNS-based website blocking (no external server) -->
        <!-- DISCLOSURE: This VPN is local-only. All traffic is handled on-device.
             No data is sent to external servers. This is used solely to block
             user-configured domains via local DNS filtering. -->
        <service
            android:name=".service.vpn.OpenFocusVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Focus Timer Foreground Service -->
        <service
            android:name=".service.timer.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Boot Receiver: Restores blocking state after device restart -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Device Admin Receiver: Enforces screen lock on 5th strike -->
        <receiver
            android:name=".receiver.FocusDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policy" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>

        <!-- Lockdown Receiver: Re-enforces lockdown overlay if user wakes screen during lockout -->
        <receiver
            android:name=".receiver.LockdownReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_ON" />
            </intent-filter>
        </receiver>

        <!-- WorkManager initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- File Provider for export/import -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
