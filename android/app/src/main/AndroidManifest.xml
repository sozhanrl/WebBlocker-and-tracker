<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== PERMISSIONS ===== -->
    <!-- Usage stats: Required for app usage analytics & screen time tracking -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Foreground service: Required for background focus study timer with ongoing notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notifications: Required for focus countdown & study alert notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot receiver: Restores active study routines and blocking after device restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Vibration: For study session start/finish alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Internet: Required for Supabase cloud sync & WebView content -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bind VPN: Required for local on-device DNS loopback domain blocker -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />

    <!-- Alarms: Required for exact scheduled routine execution -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Battery optimization exemption: Required so OEM battery killers don't terminate background focus sessions -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Query packages: Required to list installed apps on device for student block selection -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Wake lock: For timer countdown execution -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Package Visibility for Android 11+ (API 30+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="34">

        <!-- Main Capacitor Activity -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Block Screen Activity: Shown when student attempts to open a blocked app -->
        <activity
            android:name=".ui.screens.blockscreen.BlockScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- Website Blocked Activity: Shown when student queries a blocked domain -->
        <activity
            android:name=".ui.screens.blockscreen.WebsiteBlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- Lockdown Overlay Activity: Full-screen unskippable countdown during 5-minute lockdown -->
        <activity
            android:name=".ui.screens.blockscreen.LockdownOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- Device Admin Receiver: Enforces 5-minute screen lockNow() upon 5 strikes -->
        <receiver
            android:name=".receiver.FocusDeviceAdminReceiver"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policy" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Accessibility Service: Detects foreground app switches to enforce focus blocking -->
        <!-- DISCLOSURE: Monitors foreground package name ONLY to trigger block screen during active study sessions.
             Does NOT read messages, keystrokes, passwords, or personal content. -->
        <service
            android:name=".service.accessibility.OpenFocusAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- VPN Service: Local DNS loopback website blocker (on-device only) -->
        <service
            android:name=".service.vpn.OpenFocusVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Focus Timer Foreground Service -->
        <service
            android:name=".service.timer.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus study countdown timer and background session enforcement" />
        </service>

        <!-- Boot Receiver: Restores study routines on device restart -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Routine Notification Receiver: Updates routine notification on boot/time changes -->
        <receiver
            android:name=".receiver.RoutineNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- File Provider for exports -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
