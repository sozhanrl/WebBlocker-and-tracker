<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B132B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <!-- Top Badge -->
        <TextView
            android:id="@+id/tvWebsiteBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1C2541"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="🌐 DOMAIN FILTERED"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <!-- Globe Shield Icon -->
        <TextView
            android:id="@+id/tvWebsiteIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🛡️"
            android:textSize="44sp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvWebsiteTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Website Blocked"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/tvWebsiteSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="On-Device Loopback DNS Sinkhole"
            android:textColor="#9EADC8"
            android:textSize="12sp"
            android:textAlignment="center" />

        <!-- Warning Card -->
        <LinearLayout
            android:id="@+id/websiteWarningContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1C2541"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvWebsiteWarningTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Warning 1 of 5"
                android:textColor="#F59E0B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWebsiteWarningDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="5 attempts on this blocked website will trigger a mandatory 5-minute device lockdown."
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Domain Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1C2541"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blocked Domain URL"
                android:textColor="#9EADC8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDomainName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="asurascans.com"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#2E3856" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category &amp; Session"
                android:textColor="#9EADC8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWebsiteCategoryReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Distracting Website • NEET 2027 Focus Active"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnWebsiteReturn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#2563EB"
                android:text="Return to NEET Study"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnWebsiteOpenTracker"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1C2541"
                android:text="Open NEET Tracker"
                android:textColor="#9EADC8"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
