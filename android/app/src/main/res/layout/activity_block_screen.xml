<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B132B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <!-- Top Status Pill (Access Blocked or 5-Minute Lockout) -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1C2541"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="🛑 ACCESS BLOCKED"
            android:textColor="#3A86FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <!-- Icon -->
        <TextView
            android:id="@+id/tvIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔒"
            android:textSize="44sp" />

        <!-- Header Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Focus Protection Shield"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="NEET 2027 Preparation Guard"
            android:textColor="#9EADC8"
            android:textSize="12sp"
            android:textAlignment="center" />

        <!-- Warning & Lockout Status Banner -->
        <LinearLayout
            android:id="@+id/warningBannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1C2541"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvWarningTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Warning 1 of 5"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWarningDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Opening this target during your focus session will count as a distraction attempt."
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />

            <!-- Lockout Countdown Display -->
            <TextView
                android:id="@+id/tvLockoutCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#0B132B"
                android:padding="10dp"
                android:text="⏳ 5-Minute Focus Lockout: 05:00 remaining"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Blocked Target Information Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1C2541"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivBlockedAppIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Blocked Target Icon"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target App"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTargetType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Target: Distracting App"
                        android:textColor="#38BDF8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#2E3856" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reason for Blocking"
                android:textColor="#9EADC8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Your focus session for NEET 2027 is active."
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Remaining Session Time -->
            <TextView
                android:id="@+id/tvRemainingCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="⏳ Session Time Remaining"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="20dp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp">

            <!-- Return to Study Button -->
            <Button
                android:id="@+id/btnReturn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#2563EB"
                android:text="Return to NEET Study"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- End Focus Session Button -->
            <Button
                android:id="@+id/btnEndFocus"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1C2541"
                android:text="Open NEET Tracker"
                android:textColor="#9EADC8"
                android:textSize="12sp" />

            <!-- Emergency Unlock (30s) Button -->
            <Button
                android:id="@+id/btnEmergencyUnlock"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#0B132B"
                android:text="Emergency Unlock (30s hold)"
                android:textColor="#F43F5E"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
